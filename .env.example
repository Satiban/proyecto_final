# POSTGRESQL - KESTRA
KESTRA_DB_PASSWORD=<CONTRASENA_LOCAL_POSTGRES>

# ACCESO A KESTRA
KESTRA_ADMIN_EMAIL=<CORREO_ADMIN_KESTRA>
KESTRA_ADMIN_PASSWORD=<CONTRASENA_ADMIN_KESTRA>

# SNOWFLAKE (Kestra JDBC)
ENV_SNOWFLAKE_URL=jdbc:snowflake://<IDENTIFICADOR_CUENTA>.snowflakecomputing.com
ENV_SNOWFLAKE_USER=<USUARIO_SNOWFLAKE>
# Contraseña codificada en Base64 UTF-8 (utilizada por Kestra y Spark)
SECRET_SNOWFLAKE_PASSWORD=<CONTRASENA_SNOWFLAKE_EN_BASE64>
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ORALSOLUTIONS_DW
SNOWFLAKE_SCHEMA=RAW
# SNOWFLAKE - MLOPS
SF_MLOPS_SCHEMA=MLOPS

# SPARK - SNOWFLAKE
SF_ACCOUNT=<IDENTIFICADOR_CUENTA>
SF_USER=<USUARIO_SNOWFLAKE>
# Repetir contraseña en Base64 UTF-8
SF_PASSWORD=<CONTRASENA_SNOWFLAKE_EN_BASE64>
SF_WAREHOUSE=COMPUTE_WH
SF_DATABASE=ORALSOLUTIONS_DW
SF_GOLD_SCHEMA=GOLD
SF_OBT_SCHEMA=OBT
SF_ROLE=ACCOUNTADMIN

# Ruta absoluta de psets/proyecto/ visible para el motor Docker (guardar archivo en UTF-8 y LF)
# Ejemplo en GitHub Codespaces / Linux: /workspaces/data-science-end-to-end/psets/proyecto
# Ejemplo en Windows (Docker Desktop): /run/desktop/mnt/host/c/Users/<USUARIO>/Desktop/data-science-end-to-end/psets/proyecto
ENV_KESTRA_HOST_PROJECT_PATH=<RUTA_DEL_PROYECTO_VISIBLE_PARA_DOCKER>

# API - ADMINISTRACIÓN
ADMIN_TOKEN=<TOKEN_ADMINISTRATIVO>
MODO_RESPALDO=false

# API - DESPLIEGUE LOCAL POR DEFECTO
API_IMAGE=proyecto_final-api:latest
API_PULL_POLICY=build